{
  "manifest_version": 3,
  "name": "Competitive Programming Streak Tracker",
  "version": "1.0.0",
  "description": "Duolingo-style daily streaks for USACO, Codeforces, CSES, HackerRank and your own competitive programming sites.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Competitive Programming Streak",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "idle", "alarms", "notifications", "nativeMessaging"],
  "host_permissions": ["https://codeforces.com/api/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.usaco.org/*",
        "*://*.usaco.guide/*",
        "*://*.codeforces.com/*",
        "*://*.cses.fi/*",
        "*://*.hackerrank.com/*"
      ],
      "js": ["vendor/confetti.browser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
